.godot/
.runtime/
build/
*.log
*.log.old

__pycache__/
*.pyc

# Poly Haven sources are re-downloadable with tools/fetch_polyhaven.py (md5 verified)
assets/thirdparty/polyhaven/*/
# Godot extracts textures embedded in kit GLBs on import; they are regenerated.
assets/kit/*.jpg
assets/kit/*.png
assets/kit/*.jpg.import
assets/kit/*.png.import
assets/viewmodels/*.jpg
assets/viewmodels/*.png
assets/viewmodels/*.jpg.import
assets/viewmodels/*.png.import
# ...but the team arms textures are painted by tools/paint_fp_arms.py and kept.
!assets/viewmodels/arms_*_albedo.jpg
!assets/viewmodels/arms_*_albedo.jpg.import
assets/characters/*.jpg
assets/characters/*.png
assets/characters/*.jpg.import
assets/characters/*.png.import
assets/thirdparty/sketchfab/*/
